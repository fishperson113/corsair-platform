# Shared
NODE_ENV=development
LOG_LEVEL=info

# Corsair Platform
CORSAIR_DATABASE_URL=postgres://corsair:***@localhost:5432/corsair
CORSAIR_KEK_BASE64=replace-with-32-byte-base64-key
# Local default; in Encore Cloud set the same name as an Encore Secret to the deployed HTTPS URL.
CORSAIR_PUBLIC_URL=http://127.0.0.1:4000
CORSAIR_ADMIN_EMAIL=phamduong1132005@gmail.com
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
CORSAIR_API_KEY=replace-with-a-long-random-client-key

# Job Application Assistant
JOB_DATABASE_URL=postgres://jobs:jobs@localhost:5433/job_application
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
CORSAIR_URL=http://127.0.0.1:4000
CORSAIR_API_KEY=replace-me
GOOGLE_CONNECTION_ID=google-personal

# LLM
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=replace-me
AI_MODEL=replace-me
